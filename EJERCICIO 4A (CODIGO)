Iterator<Personaje> it = gremio.iterator();
while (it.hasNext()) {
    Personaje p = it.next();
    if (p.getNivel() < 5) {
        p.setEstado("inactivo");
        System.out.println("Inactivado: " + p.getNombre());
    }
}

